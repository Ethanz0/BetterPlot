Cell[BoxData[
 RowBox[{"Betterplot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"y", "+", "x"}], "==", 
      RowBox[{
       RowBox[{"x", "^", "2"}], "+", 
       RowBox[{"Tan", "[", "x", "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"5", "-", 
       RowBox[{"x", "/", "2"}]}], "==", "y"}]}], "}"}], ",", 
   RowBox[{"\"\<Asymptote\>\"", "->", "True"}], ",", 
   RowBox[{"\"\<N\>\"", "->", "False"}], ",", 
   RowBox[{"\"\<TP\>\"", "->", "True"}], ",", 
   RowBox[{"\"\<Time\>\"", "->", "7"}], ",", 
   RowBox[{"\"\<IP\>\"", "->", "True"}], ",", 
   RowBox[{"\"\<Endpoints\>\"", "->", "True"}], ",", 
   RowBox[{"PlotPoints", "->", "50"}]}], "]"}]], "Input",
