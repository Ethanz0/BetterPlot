                   RowBox[{"Flatten", "[", 
                    RowBox[{
                    RowBox[{"DeleteDuplicates", "[", 
                    RowBox[{"Select", "[", 
                    RowBox[{"endpoints", ",", 
                    RowBox[{
                    RowBox[{"UnsameQ", "[", 
                    RowBox[{"#", ",", 
                    RowBox[{"{", "}"}]}], "]"}], "&"}]}], "]"}], "]"}], ",", 
                    "1"}], "]"}]}], ",", 
                  RowBox[{"PlotStyle", "\[Rule]", 
                   RowBox[{"{", "Green", "}"}]}], ",", 
                  RowBox[{"PlotMarkers", "\[Rule]", 
                   RowBox[{"{", 
