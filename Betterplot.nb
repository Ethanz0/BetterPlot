            "\[IndentingNewLine]", ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"OptionValue", "[", "\"\<IP\>\"", "]"}], ",", 
             RowBox[{"ListPlot", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"Button", "[", 
                  RowBox[{
                   RowBox[{"Tooltip", "@", "#"}], ",", 
                   RowBox[{"Print", "[", "#", "]"}]}], "]"}], "&"}], "/@", 
                RowBox[{"Complement", "[", 
                 RowBox[{
                  RowBox[{"Join", "[", 
                   RowBox[{"IP", ",", "ihp"}], "]"}], ",", 
