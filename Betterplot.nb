                  "]"}]}], "]"}], "!=", "0"}]}], ",", "\[IndentingNewLine]", 
             RowBox[{"ContourPlot", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Evaluate", "[", "\[IndentingNewLine]", 
                RowBox[{"Join", "[", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"If", "[", 
