                    RowBox[{"r", "^", "2"}]}], ")"}]}], "-", "eq"}], "]"}]}], 
               ",", "\"\<True\>\""}], "]"}]}], "}"}], "/.", 
           RowBox[{"SolveAlways", "[", 
