Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"CircleForm", "[", "eq_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"cof", "=", 
         RowBox[{"Echo", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Coefficient", "[", 
              RowBox[{"eq", ",", "#", ",", "2"}], "]"}], "&"}], "/@", 
            RowBox[{"Variables", "[", "eq", "]"}]}], ",", 
           "\"\<Coefficients\>\""}], "]"}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"cof", "!=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{
             RowBox[{"cof", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"Length", "@", "cof"}]}], "]"}]}], ",", 
          RowBox[{"Print", "[", "\"\<coefficients not same\>\"", "]"}]}], 
         "]"}], ";", 
        RowBox[{"Echo", "[", 
         RowBox[{"Transpose", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"x", "-", "h"}], ")"}], "^", "2"}], "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"y", "-", "k"}], ")"}], "^", "2"}]}], "==", 
              RowBox[{"r", "^", "2"}]}], ",", 
             RowBox[{"If", "[", 
